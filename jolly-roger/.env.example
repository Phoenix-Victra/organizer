# Google OAuth credentials — from Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# After first OAuth flow, the refresh token is saved to token.json (gitignored)

# Google Business Profile — get these once API access is granted
GBP_ACCOUNT_ID=accounts/123456789
GBP_LOCATION_ID=locations/987654321

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Email — SMTP config for digest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
DIGEST_TO=owner@jollyrognerkdh.com

# Flask secret key for dashboard sessions — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me

# Tone/voice for Claude reply drafts (optional override; default is in config.py)
# REPLY_TONE_NOTES=
